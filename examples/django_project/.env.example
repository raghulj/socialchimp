# Copy this to .env and fill in the networks you actually want.
#
#     cp .env.example .env
#
# Nothing here is required to start the project. A network with nothing
# filled in answers "your app is not registered with this network yet" when
# somebody tries to connect it, which is the honest thing for it to say.
#
# Two of the nine need nothing in this file at all:
#
#   Mastodon - socialchimp registers the app for you, once per server, and
#              saves it in the SocialApp table. There is no portal.
#   Bluesky  - there is no app anywhere. People sign in with an app password
#              they make in Bluesky's own settings.
#
# The other seven were all typed into a developer portal by a human, and
# five of the seven are reviewed before they work for anybody but you.


# --- Django -----------------------------------------------------------

# Fine to leave alone on a laptop. Generate one for anything else:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Add your tunnel's hostname to both of these while you are testing
# webhooks. The networks that push will not reach localhost.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,shy-cat-42.ngrok-free.app
# DJANGO_CSRF_TRUSTED_ORIGINS=https://shy-cat-42.ngrok-free.app
DJANGO_CSRF_TRUSTED_ORIGINS=

# Where every network sends people back to. `{platform}` is filled in per
# network, and the finished address has to match what is typed into that
# network's portal character for character - a trailing slash is a
# different address to every one of them.
SOCIAL_REDIRECT_URI=http://localhost:8000/social/callback/{platform}


# --- Facebook Pages ---------------------------------------------------
# https://developers.facebook.com/apps - create an app, add the Facebook
# Login product, and put the redirect address above into Valid OAuth
# Redirect URIs. The id and secret are under Settings > Basic.
#
# Reviewed. pages_manage_posts, pages_read_engagement, pages_show_list and
# business_management are all reviewed permissions, and Meta separately
# wants documents proving the business behind the app is real. Two to six
# weeks is normal. Until then they work for people with a role on the app
# in the portal and fail for everybody else.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# You invent this one, and type the same string into Meta's webhook form.
# It is NOT the app secret. Meta quotes it back once, when you save the
# address, and mixing the two up is the usual reason the form says the URL
# could not be verified without saying why.
FACEBOOK_VERIFY_TOKEN=


# --- Instagram --------------------------------------------------------
# The same Meta app as Facebook Pages, at developers.facebook.com/apps,
# with the same review and the same business verification - doing one makes
# the other much quicker. Usually the same pair of values as above.
#
# Only Business and Creator accounts can publish. A personal account never
# can, through any API.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=


# --- Threads ----------------------------------------------------------
# Also developers.facebook.com/apps - and here is the thing that catches
# everybody: adding the Threads use case creates a SECOND app id and app
# secret, sitting next to the pair the same app uses for Facebook and
# Instagram. They are not interchangeable. Reusing the Facebook pair fails
# in the worst way: the sign-in page accepts it, the person approves, and
# the token swap at the very end refuses with a message that mentions none
# of this.
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_VERIFY_TOKEN=


# --- TikTok -----------------------------------------------------------
# https://developers.tiktok.com - create an app, add Login Kit and the
# Content Posting API, and add the redirect address. TikTok calls these the
# client key and the client secret; the client key is the id.
#
# Audited, and this is the one people lose a day to: until TikTok has
# audited the app, everything it posts is forced to SELF_ONLY - visible to
# the account owner and nobody else - and it may post for at most 5 people
# in 24 hours. You can ask for a public post, TikTok will answer that it
# worked, and the rest of the world will never see it. There is no error.
#
# TikTok has no verify token: it starts sending as soon as you point it at
# an address. Its webhooks are signed with the client secret below.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=


# --- YouTube ----------------------------------------------------------
# https://console.cloud.google.com/apis/credentials - turn on the YouTube
# Data API v3 and create an OAuth client.
#
# Reviewed. Uploading is a sensitive permission, so until Google's review
# passes only the test users you list can sign in.
#
# Quota, not rate limiting: 10,000 units a day and roughly 1,600 an upload,
# so about six. Running out raises RateLimitError, but retrying shortly is
# the wrong move - it resets at midnight Pacific.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=


# --- X ----------------------------------------------------------------
# https://developer.x.com/en/portal/dashboard - create the app and its
# OAuth client, agree to the terms, and add the redirect address.
#
# Paid. Posting is not on the free plan, and when your plan does not cover
# something X answers 403 with `client-not-enrolled`, which reads exactly
# like a scope you forgot to ask for. Look it up at console.x.com.
X_CLIENT_ID=
X_CLIENT_SECRET=


# --- Pinterest --------------------------------------------------------
# https://developers.pinterest.com/apps
#
# Reviewed, and quietly: a new app gets Trial access, and pins made on
# Trial are visible only to the person who made them. Real credentials,
# real 2xx replies, real pin ids, and nobody else can see the pin. Nothing
# in the API says which tier you are on.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
