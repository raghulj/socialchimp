# Copy this to .env and fill in the networks you actually want.
#
#     cp .env.example .env
#     set -a && . ./.env && set +a
#     uv run --with flask flask --app examples.flask_project run
#
# Nothing here is required to start the app. A network you have set nothing
# for says so on the connect page instead of half-working.


# ---------------------------------------------------------------------------
# This app
# ---------------------------------------------------------------------------

# Where the sqlite file goes. Created on first run.
SOCIALCHIMP_DATABASE=flask_project.sqlite3

# The address networks and browsers reach this app on. It has to be the real
# one: a network cannot send anybody back to your laptop's localhost, and it
# cannot push a webhook to it either. Use a tunnel (ngrok, cloudflared) while
# you are developing, and put the tunnel's address here.
PUBLIC_URL=http://localhost:5000

# What Flask signs session cookies with. Anybody who knows this can forge a
# session, so generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
FLASK_SECRET_KEY=

# The name people see on the Mastodon approval page.
MASTODON_APP_NAME=socialchimp Flask example


# ---------------------------------------------------------------------------
# Mastodon - nothing to set
# ---------------------------------------------------------------------------
# socialchimp registers the app for you, once per server, the first time
# somebody connects an account on that server. No portal, no waiting.


# ---------------------------------------------------------------------------
# Bluesky - nothing to set
# ---------------------------------------------------------------------------
# No developer portal exists. People sign in with an app password they make
# at https://bsky.app/settings/app-passwords, which is not their real
# password and can be revoked on its own. (This app still stores a
# placeholder credential row for Bluesky, because every sign-in looks one up
# before it starts - see config.py.)


# ---------------------------------------------------------------------------
# Facebook Pages
# ---------------------------------------------------------------------------
# Create an app at https://developers.facebook.com/apps, add the Facebook
# Login product, and put PUBLIC_URL/sign-in/callback/facebook in its valid
# OAuth redirect URIs - character for character.
#
# Meta reviews the app and requires business verification before the posting
# permissions work for anybody outside your own account. Weeks, not minutes.
# Start it early.
#
# Settings > Basic in the app dashboard.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# A value you invent and type into Meta's webhook form. Meta quotes it back
# once, when you first point it at PUBLIC_URL/webhooks/facebook. It is NOT
# the app secret - that is what signs the requests Meta pushes afterwards.
FACEBOOK_VERIFY_TOKEN=


# ---------------------------------------------------------------------------
# Instagram
# ---------------------------------------------------------------------------
# The same app, at https://developers.facebook.com/apps, with the Instagram
# product added. Same review, same business verification - doing Facebook
# first makes this one much quicker. Usually the same pair of values as
# Facebook's; separate here so you can point them at different apps.
#
# Only Business and Creator accounts can publish. A personal account never
# can, through any API.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=


# ---------------------------------------------------------------------------
# Threads - its own pair, and this is the one that catches everybody
# ---------------------------------------------------------------------------
# Adding the Threads use case to a Meta app makes a SECOND app id and app
# secret. They sit next to the Facebook pair in the same dashboard and they
# are not interchangeable. Reusing the Facebook pair here fails in the worst
# way: the sign-in page accepts it, the person approves, and the token swap
# at the very end refuses with a message that mentions none of this.
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_VERIFY_TOKEN=


# ---------------------------------------------------------------------------
# YouTube
# ---------------------------------------------------------------------------
# A project at https://console.cloud.google.com with the YouTube Data API v3
# turned on, then an OAuth client (type: Web application) with
# PUBLIC_URL/sign-in/callback/youtube in its authorised redirect URIs.
#
# Uploading is a sensitive permission, so Google reviews it. Until it passes,
# only accounts added as test users on the consent screen can sign in.
#
# Note that a Google account and a YouTube channel are different things - the
# account you test with needs a channel on it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ---------------------------------------------------------------------------
# TikTok
# ---------------------------------------------------------------------------
# An app at https://developers.tiktok.com with Login Kit and the Content
# Posting API added, and your redirect address registered.
#
# TikTok calls these the client key and the client secret. The client key is
# what goes in the client id.
#
# Until TikTok has audited the app, everything it posts is SELF_ONLY whatever
# privacy level you ask for, and it may post for at most 5 people in any 24
# hours. TikTok answers that it worked either way. Submit for the compliance
# audit before you promise anybody a public video.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=


# ---------------------------------------------------------------------------
# X
# ---------------------------------------------------------------------------
# An app and an OAuth client at https://developer.x.com/en/portal/dashboard.
# Somebody has to fill in the form, agree to the terms, choose a plan and add
# the redirect address by hand; there is no way to do it from code.
#
# Posting is on a paid plan. When your plan does not cover something X
# answers 403 with client-not-enrolled, which reads exactly like a scope your
# app forgot to ask for. Check https://console.x.com before rewriting scopes.
X_CLIENT_ID=
X_CLIENT_SECRET=


# ---------------------------------------------------------------------------
# Pinterest
# ---------------------------------------------------------------------------
# An app at https://developers.pinterest.com/apps.
#
# A new app has Trial access, where your code runs against the real API with
# real credentials and gets back real pin ids - and nobody but you can see
# the pins. Nothing in the API says which tier you are on. Getting to
# Standard is a review: a privacy policy and a video of your app taking a
# real person through the real sign-in.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
